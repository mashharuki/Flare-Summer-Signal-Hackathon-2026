# Copy this file to apps/web/.env.local for local frontend development.
# Every NEXT_PUBLIC_ value is embedded in the browser build. Do not put secrets here.

# Coston2 public RPC endpoint (chain ID 114)
NEXT_PUBLIC_COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc

# HTTPS URL of the non-custodial Attestation Worker API.
NEXT_PUBLIC_ATTESTATION_WORKER_URL=https://attestation.example.com

# Addresses from the current Coston2 deployment. These are public contract
# addresses, not credentials. Rebuild Vercel after changing them.
NEXT_PUBLIC_RESERVE_FLOW_CORE_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_FDC_HUB_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_CREDIT_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_RFUSD_ADDRESS=0x0000000000000000000000000000000000000000
